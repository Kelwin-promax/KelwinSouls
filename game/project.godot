; KelwinSouls — projeto Godot 4.7
config_version=5

[application]

config/name="KelwinSouls"
config/description="Um souls-like de mundo aberto nas Terras de Kelwin."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.06, 1)
mesh_lod/lod_change/threshold_pixels=2.0
